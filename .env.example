# Public Firebase Web App configuration.
# These values are not admin credentials.
VITE_FIREBASE_API_KEY=your_existing_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=archive-854105.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=archive-854105
VITE_FIREBASE_STORAGE_BUCKET=archive-854105.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=172192552055
VITE_FIREBASE_APP_ID=your_existing_firebase_web_app_id
VITE_USE_FIREBASE_EMULATORS=false

# Local/private admin API
NODE_ENV=development
PORT=8541
CLIENT_URL=http://localhost:5173
SESSION_SECRET=replace_with_openssl_rand_hex_32_output

# Firebase Admin SDK — SERVER ONLY.
# Keep this JSON out of Git and out of the Vite/public directory.
FIREBASE_ADMIN_SDK_KEY=./firebase-service-account.json
FIREBASE_PROJECT_ID=archive-854105

# First-time local admin bootstrap
ADMIN_BOOTSTRAP_EMAIL=your_admin_email@example.com
ADMIN_BOOTSTRAP_PASSWORD=use_a_long_random_password_here
ADMIN_BOOTSTRAP_NAME=Ayaz Ahmad
ADMIN_BOOTSTRAP_ROLE=owner

# Vercel: set these in Project Settings > Environment Variables
# FIREBASE_SERVICE_ACCOUNT_JSON = full service-account JSON (or base64 of it)
# SESSION_SECRET = long random string
# NODE_ENV = production
