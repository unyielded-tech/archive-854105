# ---- Storefront (public, safe in the browser) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# ---- Server only (NEVER prefix with VITE_) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SESSION_SECRET=long_random_string
NODE_ENV=production

# ---- First admin account (used by: npm run admin:bootstrap) ----
ADMIN_BOOTSTRAP_EMAIL=you@example.com
ADMIN_BOOTSTRAP_PASSWORD=at_least_10_characters
ADMIN_BOOTSTRAP_NAME=Owner
ADMIN_BOOTSTRAP_ROLE=owner
