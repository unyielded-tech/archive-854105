{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api"
    },
    {
      "source": "/robots.txt",
      "destination": "/api"
    },
    {
      "source": "/share/:slug",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|assets/|media/).*)",
      "destination": "/index.html"
    }
  ]
}
